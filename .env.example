#
# Pager — environment variable template
# Copy to .env.local and fill in real values.
#

# --- Local dev via docker compose (leave as-is) ---
PAGER_DB_URL=jdbc:postgresql://localhost:5432/pager
PAGER_DB_USER=pager
PAGER_DB_PASSWORD=pager
PAGER_REDIS_URL=redis://localhost:6379

# --- LLM providers (fill in when PR #06 is merged) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model routing ---
PAGER_MODEL_FAST=gpt-4o-mini
PAGER_MODEL_QUALITY=gpt-4o
PAGER_EMBED_MODEL=text-embedding-3-small

# --- Webhook security ---
PAGER_PAGERDUTY_WEBHOOK_SECRET=dev-only-change-me

# --- Budget guard ---
PAGER_DAILY_BUDGET_USD=20.00

# --- Slack (fill in when PR #10 is merged) ---
SLACK_BOT_TOKEN=
SLACK_INCIDENT_CHANNEL=
